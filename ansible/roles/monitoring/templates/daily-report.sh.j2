#!/usr/bin/env bash
set -euo pipefail

SINCE="24 hours ago"
LOGS=$(journalctl -t sshd -t sshd-session --since "$SINCE" --no-pager || true)

FAILED=$(grep -cE "Invalid user|Failed password|Connection closed by (authenticating|invalid) user" <<< "$LOGS" || true)
TOP_IPS=$(grep -E "Invalid user|authenticating user|invalid user" <<< "$LOGS" \
  | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | sort | uniq -c | sort -rn | head -5 || true)
TOP_USERS=$(grep -oE "Invalid user [^ ]+" <<< "$LOGS" | awk '{print $3}' | sort | uniq -c | sort -rn | head -5 || true)
BANNED=$(fail2ban-client status sshd | awk -F: '/Total banned/ {gsub(/ /,"",$2); print $2}')
HANDSHAKES=$(wg show wg0 latest-handshakes | while read -r key ts; do
  if [ "$ts" -eq 0 ]; then echo "${key:0:8}… never"; else echo "${key:0:8}… $(date -d @"$ts" '+%d %b %H:%M')"; fi
done)

MSG="**VPN daily report ($(hostname), $(date '+%d %b %Y'))**
Failed SSH attempts (24h): ${FAILED}
Total IPs banned by fail2ban: ${BANNED}
Top attacking IPs:
\`\`\`
${TOP_IPS:-none}
\`\`\`
Usernames tried:
\`\`\`
${TOP_USERS:-none}
\`\`\`
Last WireGuard handshakes:
\`\`\`
${HANDSHAKES:-none}
\`\`\`"

jq -n --arg c "$MSG" '{content: $c}' \
  | curl -fsS -H "Content-Type: application/json" -d @- "{{ vault_alert_webhook }}"